# Python bytecode cache
__pycache__/
*.pyc

# SQLite-Datenbanken: enthalten echte Fahrschueler-Daten und gehoeren
# niemals ins Repository (auch nicht versehentlich per "git add -A").
*.db
*.db-wal
*.db-shm

# Screenshots und Zwischenstaende aus Test-/Browserlaeufen. Die gehoeren in den
# Notizordner der Sitzung, nicht ins Projekt – landen sonst per "git add -A"
# im Repository.
/*.png
/*.jpg
/preview-*.html
/*-test*.png
